# ==========================================
# WeatherGPT Environment Variables Template
# Copy this file to .env.local and fill in your keys
# ==========================================

# 1. Google Maps & Weather API Key
NEXT_PUBLIC_GOOGLE_API_KEY=

# 2. Anthropic Claude API Key (Optional)
NEXT_PUBLIC_CLAUDE_API_KEY=

# 3. Google Gemini API Key (Optional)
NEXT_PUBLIC_GEMINI_API_KEY=

# 4. OpenAI API Key (Optional)
NEXT_PUBLIC_OPENAI_API_KEY=

# 5. MongoDB Connection (Required for authentication)
MONGODB_URI=

# 6. Session signing secret (use a long random value)
AUTH_SESSION_SECRET=

# 7. 32-byte base64 key for application-level PII encryption
AUTH_DATA_ENCRYPTION_KEY=

# 8. Gmail account used for welcome emails (use a Gmail app password)
EMAIL_USER=
EMAIL_PASS=

# 9. Twilio Verify (required for SMS OTP login)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# 10. Web Push / Vercel cron
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=
HEAVY_RAIN_THRESHOLD_MM=20
HEAVY_RAIN_PROBABILITY=70
RAIN_ALERT_LOOKAHEAD_HOURS=12
RAIN_ALERT_COOLDOWN_HOURS=6
